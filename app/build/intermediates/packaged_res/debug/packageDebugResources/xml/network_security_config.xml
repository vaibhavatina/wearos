<?xml version="1.0" encoding="utf-8"?>
<!-- Enforces HTTPS-only traffic; no cleartext, no user-added CAs trusted in production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
